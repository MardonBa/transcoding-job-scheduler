# Copy to .env and fill in. Values below are for running the Go binaries from the host against compose.
# Inside compose, override the hostnames (localhost -> postgres / redis / minio) in each service's environment block.

# --- Compose: backing services ---
POSTGRES_USER=transcoder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=transcoder

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars

# --- Shared: api, worker, scheduler ---
# Must match the POSTGRES_* values above.
DATABASE_URL=postgres://transcoder:change-me@localhost:5432/transcoder?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# Internal MinIO endpoint (minio:9000 inside compose).
MINIO_ENDPOINT=localhost:9000
# Root credentials are fine for dev. Must match MINIO_ROOT_* above.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-at-least-8-chars
MINIO_USE_SSL=false
# debug, info, warn, error
LOG_LEVEL=info

# --- api ---
HTTP_ADDR=:8080
# Used for redirects and the Origin check. Include the port if nginx isn't on 80.
APP_BASE_URL=http://localhost
# Must match the redirect URI registered with Google exactly.
OAUTH_REDIRECT_URL=http://localhost/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_TTL=168h
# true anywhere with TLS. Safari drops Secure cookies over plain http, even on localhost.
COOKIE_SECURE=false
# Host the browser sees MinIO at (through nginx). Only used to sign presigned URLs.
MINIO_PUBLIC_ENDPOINT=localhost

# Limits (reported by GET /api/config)
RATE_LIMIT_GENERAL_PER_MIN=60
RATE_LIMIT_JOBS_PER_MIN=5
RATE_LIMIT_PUBLIC_PER_MIN=30
MAX_SSE_CONNS_PER_USER=5
MAX_VIDEOS_PER_JOB=10
MAX_UNFINISHED_TASKS_PER_USER=50
# 500 MB
MAX_UPLOAD_BYTES=524288000

# --- worker ---
# Keep WORKER_SLOTS * FFMPEG_THREADS close to the number of cores.
WORKER_SLOTS=2
FFMPEG_THREADS=2
# Optional, defaults to the hostname (the container id inside compose).
WORKER_ID=
# /scratch inside the container.
SCRATCH_DIR=/tmp/transcoder-scratch

# --- scheduler ---
# Max tasks dispatched or running per user at once.
MAX_INFLIGHT_PER_USER=2
